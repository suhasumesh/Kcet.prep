MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/kcet_prep?retryWrites=true&w=majority
JWT_SECRET=generate-with-openssl-rand-hex-48
APP_URL=http://localhost:3000
# Email (optional in dev - links are printed to the server console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=KCET Prep <no-reply@kcetprep.local>

# Optional: serve the question crops from somewhere other than this deployment.
# Set it to the public base URL of a bucket holding the contents of
# public/questions (Cloudflare R2 and Vercel Blob both have a free tier), and
# the app will load every crop from there instead.
#   NEXT_PUBLIC_ASSET_BASE=https://assets.example.com
NEXT_PUBLIC_ASSET_BASE=
